# 基于Ubuntu 16.04的依赖镜像
FROM ubuntu:16.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV WORK_DIR=/opt
ENV INSTALL_DIR=/usr/local

# 创建用户
RUN useradd -m -s /bin/bash slam && \
    echo "slam ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 更新包管理器并安装基础依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    unzip \
    pkg-config \
    libgtk-3-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libjpeg-dev \
    libpng12-dev \
    libtiff5-dev \
    libatlas-base-dev \
    gfortran \
    python3-dev \
    python3-pip \
    libeigen3-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    libsuitesparse-dev \
    libblas-dev \
    liblapack-dev \
    libhdf5-dev \
    libhdf5-serial-dev \
    libqtgui4 \
    libqtwebkit4 \
    libqt4-test \
    python3-pyqt5 \
    libvtk6-dev \
    libvtk6-qt-dev \
    libtbb-dev \
    libeigen3-dev \
    libglew-dev \
    libglfw3-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

# 安装PCL (Ubuntu 16.04版本)
RUN echo "=== 安装 PCL ===" && \
    apt-get update && apt-get install -y \
    libpcl-dev \
    && rm -rf /var/lib/apt/lists/* && \
    echo "PCL 安装完成"

# 安装OctoMap (Ubuntu 16.04版本)
RUN echo "=== 安装 OctoMap ===" && \
    apt-get update && apt-get install -y \
    liboctomap-dev \
    liboctomap1.6v5 \
    octomap-tools \
    && rm -rf /var/lib/apt/lists/* && \
    echo "OctoMap 安装完成"

# 安装OpenCV 2.4.13 (原始项目要求)
RUN echo "=== 安装 OpenCV 2.4.13 ===" && \
    cd $WORK_DIR && \
    wget -O opencv-2.4.13.zip https://github.com/opencv/opencv/archive/2.4.13.zip && \
    unzip opencv-2.4.13.zip && \
    cd opencv-2.4.13 && \
    mkdir build && cd build && \
    cmake -D CMAKE_BUILD_TYPE=RELEASE \
          -D CMAKE_INSTALL_PREFIX=$INSTALL_DIR \
          -D WITH_TBB=ON \
          -D WITH_V4L=ON \
          -D WITH_QT=OFF \
          -D WITH_OPENGL=ON \
          -D BUILD_EXAMPLES=OFF \
          -D BUILD_TESTS=OFF \
          -D BUILD_PERF_TESTS=OFF \
          .. && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf opencv-2.4.13 opencv-2.4.13.zip && \
    echo "OpenCV 2.4.13 安装完成"

# 安装Pangolin (兼容Ubuntu 16.04的版本)
RUN echo "=== 安装 Pangolin ===" && \
    cd $WORK_DIR && \
    git clone https://github.com/stevenlovegrove/Pangolin.git && \
    cd Pangolin && \
    git checkout v0.5 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf Pangolin && \
    echo "Pangolin 安装完成"

# 安装NCNN (兼容Ubuntu 16.04的版本)
RUN echo "=== 安装 NCNN ===" && \
    cd $WORK_DIR && \
    git clone https://github.com/Tencent/ncnn.git && \
    cd ncnn && \
    git checkout 20211208 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR \
             -DNCNN_VULKAN=OFF \
             -DNCNN_BUILD_EXAMPLES=OFF \
             -DNCNN_BUILD_TOOLS=OFF && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf ncnn && \
    echo "NCNN 安装完成"

# 安装DBoW2 (跳过demo编译)
RUN echo "=== 安装 DBoW2 ===" && \
    cd $WORK_DIR && \
    git clone https://github.com/dorian3d/DBoW2.git && \
    cd DBoW2 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR && \
    make -j$(nproc) DBoW2 && \
    cp libDBoW2.so $INSTALL_DIR/lib/ && \
    cp -r ../../DBoW2 $INSTALL_DIR/include/ && \
    cd $WORK_DIR && rm -rf DBoW2 && \
    echo "DBoW2 安装完成"

# 安装g2o (使用兼容Ubuntu 16.04的版本)
RUN echo "=== 安装 g2o ===" && \
    cd $WORK_DIR && \
    git clone https://github.com/RainerKuemmerle/g2o.git && \
    cd g2o && \
    git checkout 20170730_git && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR \
             -DG2O_BUILD_APPS=OFF \
             -DG2O_BUILD_EXAMPLES=OFF \
             -DBUILD_WITH_MARCH_NATIVE=OFF && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf g2o && \
    echo "g2o 安装完成"

# 验证安装
RUN echo "=== 验证依赖安装 ===" && \
    echo "检查 OpenCV..." && \
    find $INSTALL_DIR -name "libopencv*" | head -1 | xargs test -f && echo "✓ OpenCV" || echo "✗ OpenCV" && \
    echo "检查 Pangolin..." && \
    find $INSTALL_DIR -name "libpangolin*" | head -1 | xargs test -f && echo "✓ Pangolin" || echo "✗ Pangolin" && \
    echo "检查 DBoW2..." && \
    find $INSTALL_DIR -name "libDBoW2*" | head -1 | xargs test -f && echo "✓ DBoW2" || echo "✗ DBoW2" && \
    echo "检查 g2o..." && \
    find $INSTALL_DIR -name "libg2o*" | head -1 | xargs test -f && echo "✓ g2o" || echo "✗ g2o" && \
    echo "检查 ncnn..." && \
    find $INSTALL_DIR -name "libncnn*" | head -1 | xargs test -f && echo "✓ ncnn" || echo "✗ ncnn" && \
    echo "所有依赖安装完成！"

# 设置环境变量
ENV PKG_CONFIG_PATH=$INSTALL_DIR/lib/pkgconfig:$PKG_CONFIG_PATH
ENV LD_LIBRARY_PATH=$INSTALL_DIR/lib:$LD_LIBRARY_PATH
ENV PATH=$INSTALL_DIR/bin:$PATH

WORKDIR /home/slam/workspace
