# ORB_SLAM2_SSD_Semantic 基础依赖镜像
# 此镜像包含所有必要的系统依赖和第三方库

FROM ubuntu:20.04

# 设置非交互式安装
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 安装基础系统依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    unzip \
    pkg-config \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libatlas-base-dev \
    gfortran \
    libgtk2.0-dev \
    libgtk-3-dev \
    libcanberra-gtk-module \
    libcanberra-gtk3-module \
    python3-dev \
    python3-numpy \
    libtbb2 \
    libtbb-dev \
    libdc1394-22-dev \
    libglew-dev \
    libboost-all-dev \
    libssl-dev \
    libusb-1.0-0-dev \
    libsuitesparse-dev \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /opt

# 安装 Eigen3
RUN git clone https://gitlab.com/libeigen/eigen.git \
    && cd eigen \
    && git checkout 3.4.0 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local \
    && make -j$(nproc) install \
    && cd /opt && rm -rf eigen

# 安装 OpenCV
RUN git clone https://github.com/opencv/opencv.git \
    && git clone https://github.com/opencv/opencv_contrib.git \
    && cd opencv && git checkout 4.5.3 \
    && cd ../opencv_contrib && git checkout 4.5.3 \
    && cd ../opencv && mkdir build && cd build \
    && cmake -D CMAKE_BUILD_TYPE=RELEASE \
             -D CMAKE_INSTALL_PREFIX=/usr/local \
             -D OPENCV_EXTRA_MODULES_PATH=../../opencv_contrib/modules \
             -D WITH_TBB=ON \
             -D WITH_V4L=ON \
             -D WITH_QT=OFF \
             -D WITH_OPENGL=ON \
             -D WITH_GSTREAMER=OFF \
             -D BUILD_EXAMPLES=OFF \
             -D BUILD_TESTS=OFF \
             -D BUILD_PERF_TESTS=OFF \
             .. \
    && make -j$(nproc) install \
    && ldconfig \
    && cd /opt && rm -rf opencv opencv_contrib

# 安装 Pangolin
RUN git clone https://github.com/stevenlovegrove/Pangolin.git \
    && cd Pangolin \
    && git checkout v0.6 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local \
    && make -j$(nproc) install \
    && cd /opt && rm -rf Pangolin

# 安装 PCL
RUN apt-get update && apt-get install -y \
    libpcl-dev \
    pcl-tools \
    && rm -rf /var/lib/apt/lists/*

# 安装 OctoMap
RUN git clone https://github.com/OctoMap/octomap.git \
    && cd octomap \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local \
    && make -j$(nproc) install \
    && cd /opt && rm -rf octomap

# 安装 NCNN
RUN git clone https://github.com/Tencent/ncnn.git \
    && cd ncnn \
    && git checkout 20230517 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local \
             -DNCNN_VULKAN=OFF \
             -DNCNN_BUILD_EXAMPLES=OFF \
             -DNCNN_BUILD_TOOLS=OFF \
    && make -j$(nproc) install \
    && cd /opt && rm -rf ncnn

# 安装 DBoW2
RUN git clone https://github.com/dorian3d/DBoW2.git \
    && cd DBoW2 \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local \
    && make -j$(nproc) install \
    && cd /opt && rm -rf DBoW2

# 安装 g2o
RUN git clone https://github.com/RainerKuemmerle/g2o.git \
    && cd g2o \
    && git checkout 20230223_git \
    && mkdir build && cd build \
    && cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local \
             -DG2O_BUILD_APPS=OFF \
             -DG2O_BUILD_EXAMPLES=OFF \
    && make -j$(nproc) install \
    && cd /opt && rm -rf g2o

# 更新动态链接库缓存
RUN ldconfig

# 设置环境变量
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig

# 创建非root用户
RUN useradd -m -s /bin/bash slam && \
    echo "slam:slam" | chpasswd && \
    adduser slam sudo && \
    echo "slam ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER slam
WORKDIR /home/slam

CMD ["/bin/bash"]
