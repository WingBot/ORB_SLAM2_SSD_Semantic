# ORB_SLAM2_SSD_Semantic 系统基础镜像
# 仅包含系统级依赖，不包含第三方库编译

FROM ubuntu:20.04

LABEL maintainer="ORB_SLAM2_SSD_Semantic Team"
LABEL description="System dependencies for ORB_SLAM2_SSD_Semantic"

# 设置非交互式安装
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

# 更新包管理器并安装基础系统依赖
RUN apt-get update && apt-get install -y \
    # 编译工具链
    build-essential \
    cmake \
    git \
    pkg-config \
    wget \
    curl \
    unzip \
    # 图像处理库
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    # 视频处理库
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    # 线性代数库
    libatlas-base-dev \
    gfortran \
    libblas-dev \
    liblapack-dev \
    # GUI支持
    libgtk2.0-dev \
    libgtk-3-dev \
    libcanberra-gtk-module \
    libcanberra-gtk3-module \
    # OpenGL支持
    libglew-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    # 其他必要库
    libboost-all-dev \
    libssl-dev \
    libusb-1.0-0-dev \
    libsuitesparse-dev \
    libtbb2 \
    libtbb-dev \
    libdc1394-22-dev \
    # Python支持（可选）
    python3-dev \
    python3-pip \
    python3-numpy \
    # 清理缓存
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 创建工作目录
WORKDIR /opt

# 设置环境变量
ENV LD_LIBRARY_PATH=/usr/local/lib
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig
ENV CMAKE_PREFIX_PATH=/usr/local

# 创建非root用户
RUN useradd -m -s /bin/bash -u 1000 slam && \
    echo "slam:slam" | chpasswd && \
    usermod -aG sudo slam && \
    echo "slam ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 创建必要的目录
RUN mkdir -p /home/slam/workspace && \
    chown -R slam:slam /home/slam

USER slam
WORKDIR /home/slam

CMD ["/bin/bash"]
