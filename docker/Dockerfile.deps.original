# 基于原始项目依赖的Dockerfile
FROM ubuntu:16.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV WORK_DIR=/opt
ENV INSTALL_DIR=/usr/local

# 创建用户
RUN useradd -m -s /bin/bash slam && \
    echo "slam ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 更新包管理器并安装基础依赖
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    unzip \
    pkg-config \
    libgtk-3-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    libxvidcore-dev \
    libx264-dev \
    libjpeg-dev \
    libpng-dev \
    libtiff-dev \
    libatlas-base-dev \
    gfortran \
    python3-dev \
    python3-pip \
    libeigen3-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    libsuitesparse-dev \
    libblas-dev \
    liblapack-dev \
    libhdf5-dev \
    libhdf5-serial-dev \
    libqtgui4 \
    libqtwebkit4 \
    libqt4-test \
    python3-pyqt5 \
    libvtk6-dev \
    zlib1g-dev \
    libjpeg-dev \
    libwebp-dev \
    libpng-dev \
    libtiff5-dev \
    libopenexr-dev \
    libgdal-dev \
    libdc1394-22-dev \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libtheora-dev \
    libvorbis-dev \
    libxvidcore-dev \
    libx264-dev \
    yasm \
    libopencore-amrnb-dev \
    libopencore-amrwb-dev \
    libv4l-dev \
    libxine2-dev \
    libtbb-dev \
    libeigen3-dev \
    libglew-dev \
    libglfw3-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR $WORK_DIR

# 安装OpenCV 2.4.13 (兼容原始项目)
RUN echo "=== 安装 OpenCV 2.4.13 ===" && \
    wget -O opencv.zip https://github.com/opencv/opencv/archive/2.4.13.zip && \
    unzip opencv.zip && \
    cd opencv-2.4.13 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR \
             -DWITH_FFMPEG=OFF \
             -DWITH_GSTREAMER=OFF \
             -DWITH_GTK=ON \
             -DWITH_QT=OFF \
             -DWITH_OPENGL=ON \
             -DWITH_TBB=ON \
             -DWITH_EIGEN=ON \
             -DWITH_V4L=ON \
             -DWITH_1394=OFF \
             -DWITH_OPENEXR=OFF \
             -DWITH_CUDA=OFF \
             -DWITH_OPENCL=OFF && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf opencv-2.4.13 opencv.zip && \
    echo "OpenCV 2.4.13 安装完成"

# 安装Pangolin
RUN echo "=== 安装 Pangolin ===" && \
    git clone https://github.com/stevenlovegrove/Pangolin.git && \
    cd Pangolin && \
    git checkout v0.5 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf Pangolin && \
    echo "Pangolin 安装完成"

# 安装PCL (使用Ubuntu 16.04可用的版本)
RUN echo "=== 安装 PCL ===" && \
    apt-get update && apt-get install -y \
    libpcl-dev \
    && rm -rf /var/lib/apt/lists/* && \
    echo "PCL 安装完成"

# 安装OctoMap
RUN echo "=== 安装 OctoMap ===" && \
    apt-get update && apt-get install -y \
    liboctomap-dev \
    liboctomap1.6v5 \
    octomap-tools \
    && rm -rf /var/lib/apt/lists/* && \
    echo "OctoMap 安装完成"

# 安装DBoW2
RUN echo "=== 安装 DBoW2 ===" && \
    git clone https://github.com/dorian3d/DBoW2.git && \
    cd DBoW2 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR && \
    make -j$(nproc) DBoW2 && \
    cp libDBoW2.so $INSTALL_DIR/lib/ && \
    cp -r ../../DBoW2 $INSTALL_DIR/include/ && \
    cd $WORK_DIR && rm -rf DBoW2 && \
    echo "DBoW2 安装完成"

# 安装g2o (使用兼容Ubuntu 16.04的版本)
RUN echo "=== 安装 g2o ===" && \
    git clone https://github.com/RainerKuemmerle/g2o.git && \
    cd g2o && \
    git checkout 20170730_git && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR \
             -DG2O_BUILD_APPS=OFF \
             -DG2O_BUILD_EXAMPLES=OFF && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf g2o && \
    echo "g2o 安装完成"

# 安装ncnn
RUN echo "=== 安装 ncnn ===" && \
    git clone https://github.com/Tencent/ncnn.git && \
    cd ncnn && \
    git checkout 20220729 && \
    mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
             -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR \
             -DNCNN_VULKAN=OFF \
             -DNCNN_BUILD_EXAMPLES=OFF \
             -DNCNN_BUILD_TOOLS=OFF && \
    make -j$(nproc) install && \
    cd $WORK_DIR && rm -rf ncnn && \
    echo "ncnn 安装完成"

# 更新动态链接库缓存
RUN ldconfig

# 验证安装
RUN echo "=== 验证安装 ===" && \
    echo "检查 OpenCV..." && \
    pkg-config --modversion opencv && \
    echo "检查 Pangolin..." && \
    find $INSTALL_DIR -name "libpangolin*" | head -1 | xargs test -f && echo "✓ Pangolin" || echo "✗ Pangolin" && \
    echo "检查 PCL..." && \
    pkg-config --modversion pcl_common-1.7 && \
    echo "检查 OctoMap..." && \
    find $INSTALL_DIR -name "liboctomap*" | head -1 | xargs test -f && echo "✓ OctoMap" || echo "✗ OctoMap" && \
    echo "检查 DBoW2..." && \
    find $INSTALL_DIR -name "libDBoW2*" | head -1 | xargs test -f && echo "✓ DBoW2" || echo "✗ DBoW2" && \
    echo "检查 g2o..." && \
    find $INSTALL_DIR -name "libg2o*" | head -1 | xargs test -f && echo "✓ g2o" || echo "✗ g2o" && \
    echo "检查 ncnn..." && \
    find $INSTALL_DIR -name "libncnn*" | head -1 | xargs test -f && echo "✓ ncnn" || echo "✗ ncnn" && \
    echo "所有依赖安装完成！"

# 设置环境变量
ENV PKG_CONFIG_PATH=$INSTALL_DIR/lib/pkgconfig:$PKG_CONFIG_PATH
ENV LD_LIBRARY_PATH=$INSTALL_DIR/lib:$LD_LIBRARY_PATH
ENV PATH=$INSTALL_DIR/bin:$PATH

WORKDIR /home/slam/workspace
